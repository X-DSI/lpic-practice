{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/X-DSI/lpic-practice/schemas/objectives.schema.json",
  "title": "LPIC exam objectives",
  "description": "Topics and weighted objectives for one exam. Weights must sum to 60 (checked by tools/validate.py).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exam", "certification", "objectives_version", "material", "exam_format", "topics"],
  "properties": {
    "schema_version": { "const": 1 },
    "exam": { "enum": ["101", "102", "201", "202"] },
    "exam_code": { "type": "string", "examples": ["101-500"] },
    "certification": { "enum": ["LPIC-1", "LPIC-2"] },
    "objectives_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "version"],
      "properties": {
        "title": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "exam_format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions", "duration_minutes"],
      "properties": {
        "questions": { "type": "integer", "minimum": 1 },
        "duration_minutes": { "type": "integer", "minimum": 1 },
        "pass_score": { "type": "integer" },
        "score_range": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "objectives"],
        "properties": {
          "id": { "type": "string", "pattern": "^\\d{3}$" },
          "title": { "type": "string" },
          "objectives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "weight", "lessons"],
              "properties": {
                "id": { "type": "string", "pattern": "^\\d{3}\\.\\d{1,2}$" },
                "title": { "type": "string" },
                "weight": { "type": "integer", "minimum": 1, "maximum": 10 },
                "lessons": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
